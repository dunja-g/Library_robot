# Run the web app without hardware. Set to false on the Raspberry Pi robot.
LIBRARY_ROBOT_USE_MOCK=true
LIBRARY_ROBOT_SERIAL_PORT=/dev/ttyACM0
# The current application is fixed-grid only; no marker mode is loaded.

# Camera and control loop
LIBRARY_ROBOT_CAMERA_WIDTH=480
LIBRARY_ROBOT_CAMERA_HEIGHT=360
LIBRARY_ROBOT_CAMERA_FPS=10
LIBRARY_ROBOT_CONTROL_HZ=10
LIBRARY_ROBOT_MISSION_TIMEOUT_SECONDS=300


# Fixed-grid safety tuning
LIBRARY_ROBOT_OBSTACLE_DISTANCE_CM=20

# Fixed-grid encoder mode. Leave dimensions blank until measured.
LIBRARY_ROBOT_GRID_FIRST_ROW_CM=
LIBRARY_ROBOT_GRID_ROW_SPACING_CM=
LIBRARY_ROBOT_GRID_APPROACH_CM=
LIBRARY_ROBOT_ENCODER_TICKS_PER_CM=
LIBRARY_ROBOT_ENCODER_TICKS_PER_REV=4
LIBRARY_ROBOT_WHEEL_DIAMETER_CM=6.5
LIBRARY_ROBOT_ENCODER_TURN_90_TICKS=
LIBRARY_ROBOT_ENCODER_TURN_180_TICKS=
LIBRARY_ROBOT_ENCODER_STALL_SECONDS=2
LIBRARY_ROBOT_GRID_TURN_SOURCE=imu
LIBRARY_ROBOT_GRID_LINEAR_SOURCE=encoder
LIBRARY_ROBOT_GRID_VISION_SOURCE=aruco
LIBRARY_ROBOT_AUTO_RETURN=true

# ArUco hybrid navigation (markers 0=hallway, 1/2/3=rows from generate_markers.py)
LIBRARY_ROBOT_ALIGN_TOLERANCE_PX=30
LIBRARY_ROBOT_ALIGNMENT_CONFIRMATION_FRAMES=2
LIBRARY_ROBOT_ARUCO_TARGET_AREA_PX=8000
# CLAHE + multi-pass detection for dim or low-contrast markers.
LIBRARY_ROBOT_ARUCO_ENHANCE_VISION=true
LIBRARY_ROBOT_ARUCO_CLAHE_CLIP_LIMIT=3.0
LIBRARY_ROBOT_ARUCO_CLAHE_TILE_GRID=8
# Extra magnified detection pass so distant markers still decode.
LIBRARY_ROBOT_ARUCO_UPSCALE_FACTOR=2.0
# Marker-like quads are alignment hints only; the requested ID must still decode.
LIBRARY_ROBOT_ARUCO_TRACK_CANDIDATES=true
LIBRARY_ROBOT_ARUCO_CANDIDATE_MIN_AREA_PX=900
LIBRARY_ROBOT_ARUCO_CANDIDATE_MAX_AREA_PX=120000
LIBRARY_ROBOT_ARUCO_CANDIDATE_CONFIRMATION_FRAMES=2
LIBRARY_ROBOT_ARUCO_CANDIDATE_MAX_JUMP_PX=80
# Vision alignment is closed loop, so it ignores INVERT_TURN_DIRECTION by
# default. Set true only if the robot still aligns away from the marker.
LIBRARY_ROBOT_ARUCO_ALIGN_INVERT_TURN=false
# Soft steering while driving is independent of pulse alignment. Flip the sign
# if forward tracking moves away from a decoded marker.
LIBRARY_ROBOT_ARUCO_STEERING_KP=-0.15
LIBRARY_ROBOT_ARUCO_ALIGN_PULSE_SECONDS=0.2
LIBRARY_ROBOT_ARUCO_ALIGN_SETTLE_SECONDS=2.0
LIBRARY_ROBOT_ARUCO_ALIGN_FINE_PULSE_SECONDS=0.12
LIBRARY_ROBOT_ARUCO_ALIGN_FINE_SETTLE_SECONDS=0.4
# Bounded search sweep: give up instead of spinning when the marker stays unseen.
LIBRARY_ROBOT_ARUCO_ALIGN_MAX_SEARCH_PULSES=6
LIBRARY_ROBOT_ARUCO_ALIGN_MAX_REACQUIRE_PULSES=2
# After the marker fills the target area, creep this many cm further inward.
LIBRARY_ROBOT_ARUCO_APPROACH_EXTRA_CM=12
# Side obstacle threshold during return turns (cm). Return reverse skips side stops.
LIBRARY_ROBOT_RETURN_OBSTACLE_DISTANCE_CM=10
# Swap left/right turn commands only if the chassis turns opposite to commands.
LIBRARY_ROBOT_INVERT_TURN_DIRECTION=false

# Residual RL steering assist. Requires torch plus a bundle directory holding
# actor.ts, manifest.json and normalization.json.
#   disabled = never loaded, shadow = infer and report only, active = drive motors
LIBRARY_ROBOT_RL_MODE=disabled
LIBRARY_ROBOT_RL_MODEL_DIR=
LIBRARY_ROBOT_RL_MAX_BIAS=5
LIBRARY_ROBOT_RL_DEADLINE_MS=50
# Flip only the RL residual sign if active steering corrects the wrong way.
LIBRARY_ROBOT_RL_INVERT_BIAS=false

# Only used when GRID_LINEAR_SOURCE=timed. Encoder mode is recommended.
LIBRARY_ROBOT_FORWARD_SPEED_CMS=

# Encoder odometry + MPU6500 complementary heading fusion.
# Initial values use 4 ticks/rev, 6.5 cm tyres and an estimated 18.0 cm
# centre-to-centre wheel track from the photographed chassis. Recalibrate.
LIBRARY_ROBOT_LEFT_TICKS_PER_CM=0.195883
LIBRARY_ROBOT_RIGHT_TICKS_PER_CM=0.195883
LIBRARY_ROBOT_WHEEL_TRACK_CM=18.0
LIBRARY_ROBOT_FUSION_ALPHA=0.95
LIBRARY_ROBOT_HEADING_KP=1.5
LIBRARY_ROBOT_MAX_HEADING_CORRECTION=30
